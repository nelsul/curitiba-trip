{
  "name": "viagem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && esbuild worker/main.ts --bundle --platform=node --format=esm --packages=external --outfile=build-worker/main.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "worker": "node --experimental-strip-types worker/main.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.12",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "drizzle-orm": "0.44.7",
    "exifr": "7.1.3",
    "maplibre-gl": "5.24.0",
    "nodemailer": "6.10.1",
    "pg-boss": "10.4.2",
    "postgres": "3.4.9"
  }
}
