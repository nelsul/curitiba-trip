# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is git-ignored. Production values live only on the server.

# Local Postgres from docker-compose.dev.yml (npm run dev:db)
DATABASE_URL=postgres://viagem:viagem@localhost:5432/viagem
ORIGIN=http://localhost:5173
AUTH_SECRET=local-dev-secret-change-me

# Email: leave empty locally. In dev mode login codes are printed in the terminal, never emailed.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Cloudflare R2 (photos/videos). Optional locally: without it the app runs, but uploads won't.
# To test uploads, create your own free R2 bucket + API token and fill these in.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
