# ── Secrets: never commit these (server, R2, email, database passwords) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.cer
*.mobileprovision.zip
ExportOptions*.plist
*.mobileprovision
GoogleService-Info.plist

# ── Web (SvelteKit) ──
node_modules/
.svelte-kit/
build/
build-worker/

# ── iOS (Xcode / SwiftPM) ──
# The Xcode project is generated from ios/project.yml with XcodeGen
ios/*.xcodeproj/
xcuserdata/
DerivedData/
*.xcuserstate
.build/
.swiftpm/
*.ipa
*.dSYM.zip
Config/Secrets.xcconfig
ios/Config/Local.xcconfig

# ── Logs, database dumps (migrations in web/drizzle/*.sql ARE committed) ──
*.log
*.dump
*.sql.gz
backups/

# ── OS / editors ──
.DS_Store
.vscode/
.idea/
.claude/settings.local.json

# ── Android (Gradle) ──
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/
android/keystore/
android/keystore.properties
*.jks
*.keystore
*.apk
*.aab
